  "strappings": [
    {
      "name": "RESET",
      "pins": [
        {
          "name": "RESET",
          "level": false
        }
      ]
    },
    {
      "name": "ROM_BOOTSTRAP",
      "pins": [
        {
          "name": "SW_STRAP0",
          "level": true
        },
        {
          "name": "SW_STRAP1",
          "level": true
        },
        {
          "name": "SW_STRAP2",
          "level": true
        }
      ]
    },
    // QEMU does not currently model TAP straps, the JTAG interfaces are always available.
    // For now we model both straps as no-ops without any pins.
    {
      "name": "PINMUX_TAP_RISCV",
      "pins": [
        {
          "name": "TAP_STRAP0",
          "mode": "PushPull",
          "level": false
