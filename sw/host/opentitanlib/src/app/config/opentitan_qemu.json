      "mode": "PushPull",
      "level": false,
      "pull_mode": "None",
      "alias_of": "30"
    },
    {
      "name": "TAP_STRAP1",
      "mode": "PushPull",
      "level": false,
      "pull_mode": "None",
      "alias_of": "27"
    },
    {
